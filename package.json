    "@types/sanitize-html": "^2.16.2",
    "marked": "^18.0.14",
    "sanitize-html": "^2.17.7",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
